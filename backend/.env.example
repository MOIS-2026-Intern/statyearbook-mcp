# 이 파일을 .env.local로 복사하고 선택한 채팅 provider의 키만 설정합니다.
# STATYEARBOOK_BACKEND_OPENAI_API_KEY=...
# main에서는 실제 frontend origin을 쉼표로 구분해 설정합니다.
# STATYEARBOOK_BACKEND_CORS_ORIGINS=https://statistics.example.go.kr
# 독립 배포된 app 서비스의 외부 또는 내부 MCP URL을 설정합니다.
# STATYEARBOOK_BACKEND_MCP_URL=https://mcp.example.go.kr/mcp
# MCP 도구 사양은 기본 300초 동안 재사용합니다. 0이면 캐시를 끕니다.
# STATYEARBOOK_BACKEND_MCP_TOOL_CACHE_TTL_SECONDS=300
# STATYEARBOOK_BACKEND_BIZROUTER_API_KEY=...
# STATYEARBOOK_BACKEND_BIZROUTER_BASE_URL=https://api.bizrouter.ai/v1
# 모델 응답 1회의 최대 출력 토큰입니다. 추론 토큰도 여기에 함께 계산되므로
# 값이 작으면 답변이 중간에 끊깁니다.
# STATYEARBOOK_BACKEND_MODEL_MAX_OUTPUT_TOKENS=16000
# 긴 답변이 끝날 때까지 기다릴 수 있어야 합니다.
# STATYEARBOOK_BACKEND_MODEL_TIMEOUT_SECONDS=200
# 종료 신호 뒤 진행 중인 스트림을 기다릴 최대 시간입니다. 초과하면 요청을 취소합니다.
# STATYEARBOOK_BACKEND_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=5
# 모델의 추론 강도입니다. 공급자마다 허용하는 값이 다르므로 CHAT_MODEL에 맞춰 고정합니다.
# 빈 값으로 두면 필드를 보내지 않고 공급자 기본값을 씁니다.
# STATYEARBOOK_BACKEND_MODEL_REASONING_EFFORT=medium
# 한 질문에서 모델이 도구를 호출할 수 있는 최대 라운드 수입니다. 이 횟수를 다 쓰면
# 도구 목록은 그대로 두고 호출만 막은 최종 턴이 한 번 더 실행됩니다.
# STATYEARBOOK_BACKEND_MAX_TOOL_ROUNDS=5
# 답변을 생성되는 대로 흘려보냅니다. 공급자나 모델이 스트리밍을 거부하면
# 경고 로그를 남기고 자동으로 비스트리밍으로 되돌아갑니다. 끄려면 false로 둡니다.
# STATYEARBOOK_BACKEND_MODEL_STREAMING=true
# DEBUG, INFO, WARNING, ERROR, CRITICAL 중 하나를 사용합니다.
STATYEARBOOK_BACKEND_LOG_LEVEL=DEBUG
